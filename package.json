{
	"name": "obsidian-legal-core",
	"version": "0.1.0",
	"description": "Shared foundation for Australian legal-writing plugins: one store of cases, legislation and sources, a Word export engine with AGLC4 formatting, and an API that other plugins extend.",
	"main": "main.js",
	"type": "module",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run && node scripts/offline-audit.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"dev:vault": "node scripts/dev-vault.mjs"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"law",
		"legal",
		"australia",
		"aglc4",
		"authorities"
	],
	"author": "blursedperf",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint/js": "^9.39.5",
		"@types/node": "^26.6.6",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"jszip": "^3.10.2",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"@legal-core/ldm": "*",
		"@legal-core/md-pipeline": "*",
		"@legal-core/docx-engine": "*",
		"@legal-core/aglc": "*",
		"@legal-core/authority-store": "*",
		"@legal-core/api": "*",
		"fflate": "^0.8.3",
		"@legal-core/chronology": "*",
		"@legal-core/precise-date": "*"
	}
}
